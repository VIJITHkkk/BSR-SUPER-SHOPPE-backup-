<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BSR Super Shoppe & Fish Stall</title>
</head>
<body>
<body>

<!-- HEADER -->

<header>

<img src="logo.png" class="logo">

<div class="shop-name">
BSR Super Shoppe & Fish Stall
</div>

<div class="search-box">

<input
type="text"
id="searchInput"
placeholder="Search Products..."
onkeyup="searchProducts()">

</div>

</header>

<!-- HOME PAGE -->

<div id="homePage">

<div class="banner">

<video autoplay muted loop playsinline controls>

<source src="banner.mp4" type="video/mp4">

</video>

</div>

<div class="title">
Fresh Fish, Chicken, Beef & Mutton Home Delivery
</div>

</div>

<!-- CATEGORY PAGE -->

<div id="categoryPage" style="display:none;">

<div class="title">
Categories
</div>

<div class="products">

<!-- AYALA -->

<div class="product product-item">

<img src="ayala.jpg">

<h2>അയല</h2>

<div class="price">
₹220 / KG
</div>

<input
type="number"
id="qty1"
class="qty-input"
placeholder="Quantity">

<button
onclick="addToCart('അയല',220,'qty1')">

Add To Cart

</button>

</div>

<!-- MATHI -->

<div class="product product-item">

<img src="mathi.jpg">

<h2>മത്തി</h2>

<div class="price">
₹180 / KG
</div>

<input
type="number"
id="qty2"
class="qty-input"
placeholder="Quantity">

<button
onclick="addToCart('മത്തി',180,'qty2')">

Add To Cart

</button>

</div>

<!-- LIVE CHICKEN -->

<div class="product product-item">

<img src="chicken.jpg">

<h2>Live Chicken</h2>

<div class="price">
₹150 / KG
</div>

<select
id="chickenType"
class="qty-input"
onchange="updateChickenInput()">

<option value="Live Chicken">
Live Chicken
</option>

<option value="Chicken Meat">
Chicken Meat
</option>

</select>

<input
type="number"
step="0.1"
id="chickenQty"
class="qty-input"
placeholder="Expected Weight (KG)">

<button
onclick="addChickenToCart()">

Add To Cart

</button>

</div>

<!-- BEEF -->

<div class="product product-item">

<img src="beef.jpg">

<h2>Beef</h2>

<div class="price">
₹440 / KG
</div>

<input
type="number"
id="qty4"
class="qty-input"
placeholder="Quantity">

<button
onclick="addToCart('Beef',440,'qty4')">

Add To Cart

</button>

</div>

<!-- MUTTON -->

<div class="product product-item">

<img src="mutton.jpg">

<h2>Mutton</h2>

<div class="price">
₹800 / KG
</div>

<input
type="number"
id="qty5"
class="qty-input"
placeholder="Quantity">

<button
onclick="addToCart('Mutton',800,'qty5')">

Add To Cart

</button>

</div>

</div>

</div>

<!-- CART PAGE -->

<div id="cartPage" style="display:none;">

<div class="cart-section">

<h2>🛒 Cart Items</h2>

<div id="cartItems">

No items added

</div>

<input
type="text"
id="customerName"
class="location-input"
placeholder="Customer Name">

<input
type="number"
id="customerNumber"
class="location-input"
placeholder="Mobile Number">

<input
type="text"
id="customerLocation"
class="location-input"
placeholder="Delivery Location">

<h2 style="margin-top:20px;">

🧾 Grand Total :
₹<span id="grandTotal">0</span>

</h2>

<button onclick="sendWhatsAppOrder()">

Order Now

</button>

</div>

</div>

<!-- ACCOUNT PAGE -->

<div id="accountPage" style="display:none;">

<div class="cart-section">

<h2>👤 Account</h2>

<p>
BSR Super Shoppe & Fish Stall
</p>

<p>
Fresh Fish, Chicken, Beef & Mutton
</p>

</div>

</div>

<!-- BOTTOM NAV -->

<div class="bottom-nav">

<a href="#" onclick="showPage('homePage')">
🏠<br>Home
</a>

<a href="#" onclick="showPage('categoryPage')">
🐟<br>Category
</a>

<a href="#" onclick="showPage('cartPage')">
🛒<br>Cart
</a>

<a href="#" onclick="showPage('accountPage')">
👤<br>Account
</a>

</div>
